# Twilio — Daniel confirma cuál número; NO compres otro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=          # formato +5215512345678 (sin "whatsapp:")

# Supabase (sin estas vars → bus en memoria + BroadcastChannel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_GEOCODING_API_KEY=        # opcional; sin key → Nominatim (1 req/s, solo demo)
PHONE_HASH_SALT=                 # opcional: si falta se deriva de SUPABASE_SERVICE_ROLE_KEY / TWILIO_AUTH_TOKEN
NEXT_PUBLIC_MAP_STYLE=           # default CARTO Dark Matter GL
NEXT_PUBLIC_SAT_TILES=           # raster XYZ, p. ej. https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x} (revisar términos). Vacío → oculta MAP/SAT
OPENAI_API_KEY=                  # LLM opcional, solo reformula
LLM_REPLY=                       # "1" para activar la reformulación con LLM (requiere OPENAI_API_KEY)
PUBLIC_BASE_URL=                 # https://<app>.vercel.app o URL de ngrok: para validar firma Twilio
DEMO_NOW=                        # reloj de demo, p. ej. 2026-10-29T09:00-06:00; vacío = hora real
DEMO_SCENARIOS=                  # "1" para que los escenarios [DEMO] apliquen también a tráfico real de WhatsApp (en /dev y ?mock=1 siempre aplican)
DEV_KEY=                         # opcional: protege /api/dev/simulate en producción (/dev?key=...)

# Fase 6 · llamada de alerta (ElevenLabs). Dry-run por defecto: solo llama con VOICE_DRY_RUN=0 + ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=              # solo servidor
ELEVENLABS_AGENT_ID=agent_9501m674z09mfptt3z954cmmfrbg
ELEVENLABS_SED_PHONE_ID=phnum_5701m4vx6vvsfz1bn8bz4nzn4320      # +1 832 346 6398, asignado al agente de Sed. NUNCA phnum_8701… (Sofía)
VOICE_DRY_RUN=1                  # "0" para llamadas reales (solo con el OK de Daniel)
VOICE_LIVE=                      # "1" activa llamadas reales (equivale a VOICE_DRY_RUN=0)
INTERNAL_KEY=                    # opcional: sin ella POST /api/voice-alert responde 401 (el bot llama en proceso, no la necesita)
